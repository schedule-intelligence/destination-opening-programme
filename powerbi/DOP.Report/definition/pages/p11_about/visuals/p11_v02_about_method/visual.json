              {
                "textRuns": [
                  {
                    "value": "How the dates are produced",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13px",
                      "color": "#1F3A5F",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Schedules are exported in Primavera P6 XER format and re-scheduled by a CPM engine that follows P6 conventions: working-time calendars, FS/SS/FF/SF links with lags, constraints, retained logic at the data date.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#1A202C"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Total float = late finish - early finish. The longest path is traced through driving relationships and kept separate from float <= 0.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#1A202C"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The engine reproduces the exported dates and floats exactly (control R16).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#1A202C"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
