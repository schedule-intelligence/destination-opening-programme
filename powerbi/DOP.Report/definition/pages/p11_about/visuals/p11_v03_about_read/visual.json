              {
                "textRuns": [
                  {
                    "value": "How to read the numbers",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13px",
                      "color": "#1F3A5F",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Float and durations are in working days; variances, slips and gaps are in calendar days, and a positive variance is later.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#1A202C"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Variance is measured against the baseline in force (BL1 from 30-Jul-2026) unless a page says otherwise. Near-critical means float at or below the threshold (10 working days by default).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#1A202C"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "An update is published only when all reconciliation controls agree between the source XER, the model and the dashboard.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11px",
                      "color": "#1A202C"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
