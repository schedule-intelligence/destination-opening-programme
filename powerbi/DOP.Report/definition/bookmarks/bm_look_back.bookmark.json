            }
          },
          "p03_h16_ahead_on": {
            "singleVisual": {
              "display": {
                "mode": "hidden"
              }
            }
          },
          "p03_h17_ahead_off": {
            "singleVisual": {}
          },
          "p03_v06_look_back": {
            "singleVisual": {}
          },
          "p03_h18_back_on": {
            "singleVisual": {}
          },
          "p03_h19_back_off": {
            "singleVisual": {
              "display": {
                "mode": "hidden"
              }
            }
          }
        }
      }
    }
  }
