{
  "name": "dop_theme.json",
  "dataColors": [
    "#1F3A5F",
    "#2B7A78",
    "#B7791F",
    "#8E6C8A",
    "#64748B",
    "#C0392B",
    "#D68910",
    "#1E8449"
  ],
  "background": "#FFFFFF",
  "backgroundLight": "#F7F8FA",
  "backgroundNeutral": "#E2E8F0",
  "foreground": "#1A202C",
  "foregroundNeutralSecondary": "#4A5568",
  "foregroundNeutralTertiary": "#64748B",
  "tableAccent": "#1F3A5F",
  "good": "#1E8449",
  "neutral": "#D68910",
  "bad": "#C0392B",
  "maximum": "#C0392B",
  "center": "#D68910",
  "minimum": "#1E8449",
  "null": "#E2E8F0",
  "hyperlink": "#2B7A78",
  "visitedHyperlink": "#8E6C8A",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3A5F"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1A202C"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1A202C"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4A5568"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F7F8FA" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#E9EDF2" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 8,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#1A202C" } },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 10,
            "angle": 90,
            "shadowDistance": 2,
            "transparency": 90
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": { "solid": { "color": "#1A202C" } },
            "alignment": "left"
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColor": { "solid": { "color": "#4A5568" } }
          }
        ],
        "value": [
          {
            "$id": "default",
            "fontFamily": "Segoe UI Semibold",
            "fontColor": { "solid": { "color": "#1F3A5F" } }
          }
        ],
        "label": [
          {
            "$id": "default",
            "fontFamily": "Segoe UI",
            "fontColor": { "solid": { "color": "#4A5568" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColor": { "solid": { "color": "#4A5568" } }
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#1F3A5F" } },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#4A5568" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColor": { "solid": { "color": "#4A5568" } }
          }
        ],
        "dataLabels": [
          {
            "color": { "solid": { "color": "#1F3A5F" } },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#4A5568" } },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#E2E8F0" } },
            "gridlineStyle": "dotted",
            "gridlineThickness": 1,
            "labelColor": { "solid": { "color": "#4A5568" } },
            "titleColor": { "solid": { "color": "#4A5568" } }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#4A5568" } },
            "titleColor": { "solid": { "color": "#4A5568" } }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#E2E8F0" } },
            "gridlineStyle": "dotted",
            "gridlineThickness": 1,
            "labelColor": { "solid": { "color": "#4A5568" } },
            "titleColor": { "solid": { "color": "#4A5568" } }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#4A5568" } },
            "titleColor": { "solid": { "color": "#4A5568" } }
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#E2E8F0" } },
            "gridlineStyle": "dotted",
            "gridlineThickness": 1,
            "labelColor": { "solid": { "color": "#4A5568" } },
            "titleColor": { "solid": { "color": "#4A5568" } }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#4A5568" } },
            "titleColor": { "solid": { "color": "#4A5568" } }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridlineStyle": "dotted",
            "gridlineThickness": 1,
            "labelColor": {
              "solid": {
                "color": "#4A5568"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#4A5568"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#4A5568"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#4A5568"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1F3A5F" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1A202C" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1A202C" } },
            "backColorSecondary": { "solid": { "color": "#F7F8FA" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E2E8F0" } },
            "gridVertical": false
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1F3A5F" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#1A202C" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1A202C" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1A202C" } },
            "backColorSecondary": { "solid": { "color": "#F7F8FA" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": { "solid": { "color": "#4A5568" } },
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#1A202C" } },
            "fontFamily": "Segoe UI",
            "textSize": 10
          }
        ],
        "dropShadow": [
          { "show": false }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          { "show": false }
        ],
        "border": [
          { "show": false }
        ],
        "dropShadow": [
          { "show": false }
        ]
      }
    }
  }
}
