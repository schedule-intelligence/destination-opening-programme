	partition fact_scenario-64b62646-b2f6-57ca-965d-8da189fc0af3 = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "\fact_scenario.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Nulls, {
				        {"scenario_id", type text},
				        {"name", type text},
				        {"options", type text},
				        {"owner", type text},
				        {"day1_forecast", type datetime},
				        {"day1_impact_days", type number},
				        {"day1_tf_d", type number},
				        {"float_gain_d", type number},
				        {"neg_float_count", Int64.Type},
				        {"near_critical_count", Int64.Type},
				        {"recommended", type logical},
				        {"decision", type text},
				        {"cost", type text},
				        {"description", type text},
				        {"residual_risk", type text}
				    }, "en-GB"),
				    Dates = Table.TransformColumnTypes(Typed, {
				        {"day1_forecast", type date}
				    }),
				    Label_recommended = Table.AddColumn(Dates, "recommended_label", each if [recommended] = null then null else if [recommended] then "Yes" else "No", type text)
				in
				    Label_recommended
				```

	annotation PBI_ResultType = Table
