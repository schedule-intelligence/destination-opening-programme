				    Source = Csv.Document(Web.Contents(CsvFolder, [RelativePath = "fact_dcma_check.csv"]), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
