	partition fact_activity_snapshot-6dee849e-c3d1-5c59-abae-dd0bb34c7093 = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(Web.Contents(CsvFolder, [RelativePath = "fact_activity_snapshot.csv"]), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Nulls, {
				        {"snapshot_id", Int64.Type},
				        {"activity_id", type text},
				        {"status", type text},
				        {"pct_duration", type number},
				        {"pct_physical", type number},
				        {"orig_dur_d", type number},
				        {"rem_dur_d", type number},
				        {"actual_start", type datetime},
				        {"actual_finish", type datetime},
				        {"start", type datetime},
				        {"finish", type datetime},
				        {"late_start", type datetime},
				        {"late_finish", type datetime},
				        {"total_float_d", type number},
				        {"free_float_d", type number},
				        {"is_critical", type logical},
				        {"is_near_critical", type logical},
				        {"is_longest_path", type logical},
				        {"bl0_start", type datetime},
				        {"bl0_finish", type datetime},
				        {"bl1_start", type datetime},
				        {"bl1_finish", type datetime},
				        {"bl_start", type datetime},
				        {"bl_finish", type datetime},
				        {"var_finish_bl0_d", type number},
				        {"var_finish_bl1_d", type number},
				        {"var_finish_bl_d", type number},
				        {"prev_finish", type datetime},
				        {"slip_vs_prev_d", type number},
				        {"lookback_event", type text},
				        {"lookback_achieved", type logical},
				        {"lookahead_start", type logical},
				        {"lookahead_finish", type logical},
				        {"lookahead", type logical},
				        {"planned_pct_bl", type number},
				        {"constraint_type", type text},
				        {"constraint_date", type datetime},
				        {"dq_flags", type text}
				    }, "en-GB"),
				    Dates = Table.TransformColumnTypes(Typed, {
				        {"actual_start", type date},
				        {"actual_finish", type date},
				        {"start", type date},
				        {"finish", type date},
				        {"late_start", type date},
				        {"late_finish", type date},
				        {"bl0_start", type date},
				        {"bl0_finish", type date},
				        {"bl1_start", type date},
				        {"bl1_finish", type date},
				        {"bl_start", type date},
				        {"bl_finish", type date},
				        {"prev_finish", type date},
				        {"constraint_date", type date}
				    }),
				    Label_lookback_achieved = Table.AddColumn(Dates, "lookback_achieved_label", each if [lookback_achieved] = null then null else if [lookback_achieved] then "Yes" else "No", type text)
				in
				    Label_lookback_achieved
				```

