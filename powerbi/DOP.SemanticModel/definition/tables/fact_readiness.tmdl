	partition fact_readiness-acbcd3f4-79f9-5de9-91b2-ca4003664f8a = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(Web.Contents(CsvFolder, [RelativePath = "fact_readiness.csv"]), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Nulls, {
				        {"snapshot_id", Int64.Type},
				        {"asset_code", type text},
				        {"stage", type text},
				        {"activity_id", type text},
				        {"forecast", type datetime},
				        {"baseline", type datetime},
				        {"need_by", type datetime},
				        {"gap_d", type number},
				        {"var_bl_d", type number},
				        {"span_from_prev_d", type number},
				        {"status", type text},
				        {"total_float_d", type number}
				    }, "en-GB"),
				    Dates = Table.TransformColumnTypes(Typed, {
				        {"forecast", type date},
				        {"baseline", type date},
				        {"need_by", type date}
				    }),
				    Staged = Table.AddColumn(Dates, "stage_order", each 1 + List.PositionOf({"Construction complete", "T&C complete", "Handover to operator", "Operator trained", "Trials & test events complete", "Day 1 ready"}, [stage]), Int64.Type)
				in
				    Staged
				```

	annotation PBI_ResultType = Table
