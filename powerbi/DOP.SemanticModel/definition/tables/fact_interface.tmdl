				        {"receiver_asset", type text},
				        {"giver_ws", type text},
				        {"receiver_ws", type text},
				        {"need_by", type datetime},
				        {"giver_forecast", type datetime},
				        {"gap_days", Int64.Type},
				        {"status", type text},
				        {"giver_tf_d", type number}
				    }, "en-GB"),
				    Dates = Table.TransformColumnTypes(Typed, {
				        {"need_by", type date},
				        {"giver_forecast", type date}
				    })
				in
				    Dates
				```

