	partition fact_interface-835b28bb-8a55-56c1-a8a5-549a8d2cfe6e = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(Web.Contents(CsvFolder, [RelativePath = "fact_interface.csv"]), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Nulls, {
				        {"snapshot_id", Int64.Type},
				        {"interface_id", type text},
				        {"giver_id", type text},
				        {"receiver_id", type text},
				        {"description", type text},
				        {"giver_owner", type text},
				        {"receiver_owner", type text},
