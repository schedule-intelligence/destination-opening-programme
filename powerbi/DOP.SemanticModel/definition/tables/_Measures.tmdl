	/// BEI = tasks completed / tasks due by the data date in the baseline in force (DCMA D14, LOE excluded). Baseline finishes fall at the end of the working day, so a baseline finish on the data date is not yet due.
	measure 'BEI tasks completed' = ```
			VAR _sid = [Selected snapshot id]
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_activity_snapshot ),
			        dim_snapshot[snapshot_id] = _sid,
			        dim_activity[activity_type] <> "TT_LOE",
			        fact_activity_snapshot[status] = "TK_Complete"
