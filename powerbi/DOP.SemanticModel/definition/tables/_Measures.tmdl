	measure 'Provenance line' = ```
			"Data date " & FORMAT ( [Data date], "dd-mmm-yyyy" )
			    & " | Baseline " & [Baseline in force]
			    & " | " & [Reconciliation status] & " " & [Controls passed] & "/" & [Controls total]
