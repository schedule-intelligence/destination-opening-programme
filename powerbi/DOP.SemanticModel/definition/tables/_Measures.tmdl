	/// Float erosion: change in Day 1 total float since the previous update (negative = float lost). The first update has no previous update, so the pipeline value (vs BL0) is used.
	measure 'Float erosion' = ```
			VAR _sid = [Selected snapshot id]
			VAR _prev = [Previous snapshot id]
			VAR _tf =
			    CALCULATE (
			        SUM ( fact_snapshot_summary[day1_tf_d] ),
			        REMOVEFILTERS ( dim_snapshot ),
			        dim_snapshot[snapshot_id] = _sid
			    )
			VAR _tfPrev =
			    CALCULATE (
			        SUM ( fact_snapshot_summary[day1_tf_d] ),
			        REMOVEFILTERS ( dim_snapshot ),
			        dim_snapshot[snapshot_id] = _prev
			    )
			VAR _first =
			    CALCULATE (
			        SUM ( fact_snapshot_summary[float_erosion_d] ),
			        REMOVEFILTERS ( dim_snapshot ),
			        dim_snapshot[snapshot_id] = _sid
			    )
			RETURN
			    IF ( ISBLANK ( _prev ), _first, _tf - _tfPrev )
			```
		formatString: +0;-0;0
		displayFolder: 02 Day 1 headline
		lineageTag: 1db1621d-49ca-5220-bb3f-a73a81d354df

	/// Float bridge (the waterfall on page 3): the first update's Day 1 total float, then the change at each later update, so the bars add up to the float of the last update shown
	measure 'Float bridge' = IF ( ISBLANK ( [Previous snapshot id] ), [Day 1 total float], [Float erosion] )
		formatString: +0;-0;0
		displayFolder: 02 Day 1 headline
		lineageTag: 39a2aebe-cf12-58f5-9fc8-977fbe4fcb8e

	/// RAG colour for the Day 1 card (conditional formatting > Field value)
	measure 'Day 1 RAG colour' = ```
			VAR _tf = [Day 1 total float]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _tf ), "#64748B",
			        _tf < 0, "#C0392B",
			        _tf <= [Near-critical threshold (d)], "#D68910",
			        "#1E8449"
			    )
			```
		displayFolder: 02 Day 1 headline
		lineageTag: ec7d1010-e725-5697-bf4d-a74940d26406

	measure 'Planned % complete' = ```
			VAR _sid = [Selected snapshot id]
			VAR _t =
			    CALCULATETABLE (
			        fact_activity_snapshot,
			        dim_snapshot[snapshot_id] = _sid,
			        dim_activity[activity_type] = "TT_Task",
			        fact_activity_snapshot[orig_dur_d] > 0
			    )
			VAR _num = SUMX ( _t, fact_activity_snapshot[orig_dur_d] * fact_activity_snapshot[planned_pct_bl] )
			VAR _den = SUMX ( _t, fact_activity_snapshot[orig_dur_d] )
			RETURN
			    DIVIDE ( _num, _den ) / 100
			```
		formatString: 0.0%
		displayFolder: 03 Progress
		lineageTag: 48157b30-7cf2-5b62-9bce-363486c8555a

	measure 'Weighted % complete (actual)' = ```
			VAR _sid = [Selected snapshot id]
			VAR _t =
			    CALCULATETABLE (
			        fact_activity_snapshot,
			        dim_snapshot[snapshot_id] = _sid,
			        dim_activity[activity_type] = "TT_Task",
			        fact_activity_snapshot[orig_dur_d] > 0
			    )
			VAR _num = SUMX ( _t, fact_activity_snapshot[orig_dur_d] * fact_activity_snapshot[pct_duration] )
			VAR _den = SUMX ( _t, fact_activity_snapshot[orig_dur_d] )
			RETURN
			    DIVIDE ( _num, _den ) / 100
			```
		formatString: 0.0%
		displayFolder: 03 Progress
		lineageTag: 95730e2f-40d2-50ed-8e25-8dfaee1234a0

	/// Percentage points; negative = behind plan
	measure 'Progress variance (pts)' = ( [Weighted % complete (actual)] - [Planned % complete] ) * 100
		formatString: 0.0
		displayFolder: 03 Progress
		lineageTag: cf72744c-7f31-5506-94bd-bb813395a6d9

