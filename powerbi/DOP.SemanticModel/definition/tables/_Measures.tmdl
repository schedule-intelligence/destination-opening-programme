	/// Sparkline: the owner's DQ (share of activities not flagged), by update
	measure 'Owner DQ by update' = ```
			VAR _s = SELECTEDVALUE ( 'Update axis'[snapshot_id] )
			RETURN
			    IF (
			        NOT ISBLANK ( _s ) && _s <= [Selected snapshot id] && NOT ISEMPTY ( fact_owner_scorecard ),
			        CALCULATE ( [Owner DQ], REMOVEFILTERS ( dim_snapshot ), dim_snapshot[snapshot_id] = _s )
			    )
			```
		formatString: 0.0%
		displayFolder: 15 Sparklines in the tables, and the float bridge
		lineageTag: 7a7ff172-79a7-55b5-8da4-356982e6929e

	/// Sparkline: the milestone's forecast finish against BL1, in calendar days, by update
	measure 'Milestone variance vs BL1 by update' = ```
			VAR _s = SELECTEDVALUE ( 'Update axis'[snapshot_id] )
			RETURN
			    IF (
			        NOT ISBLANK ( _s ) && _s <= [Selected snapshot id] && NOT ISEMPTY ( fact_activity_snapshot ),
			        CALCULATE ( [Milestone variance vs BL1], REMOVEFILTERS ( dim_snapshot ), dim_snapshot[snapshot_id] = _s )
			    )
			```
		formatString: +0;-0;0
		displayFolder: 15 Sparklines in the tables, and the float bridge
		lineageTag: 3fc0460c-88d1-5295-9c39-c3ee2df6d60c

	/// Sparkline: the risk's score, by update
	measure 'Risk score (max) by update' = ```
			VAR _s = SELECTEDVALUE ( 'Update axis'[snapshot_id] )
			RETURN
			    IF (
			        NOT ISBLANK ( _s ) && _s <= [Selected snapshot id] && NOT ISEMPTY ( fact_risk ),
			        CALCULATE ( [Risk score (max)], REMOVEFILTERS ( dim_snapshot ), dim_snapshot[snapshot_id] = _s )
			    )
			```
		formatString: 0
