table _Measures
	lineageTag: 9e6abd37-4a38-5c7b-b41d-70ed09b6b8f9

	/// One update selected on the data-date slicer -> that update; none or several -> the latest in context
	measure 'Selected snapshot id' = SELECTEDVALUE ( dim_snapshot[snapshot_id], MAX ( dim_snapshot[snapshot_id] ) )
		formatString: 0
		displayFolder: 01 Context
		lineageTag: 7385ce6e-11a5-551e-b6a8-b5e16d0e2668

	measure 'Previous snapshot id' = ```
			VAR _sid = [Selected snapshot id]
			RETURN
			    CALCULATE (
			        MAX ( dim_snapshot[snapshot_id] ),
			        REMOVEFILTERS ( dim_snapshot ),
			        dim_snapshot[snapshot_id] < _sid
			    )
			```
		formatString: 0
		displayFolder: 01 Context
		lineageTag: 0e0937c3-1425-5612-90af-83a0f94e49a4

	measure 'Data date' = ```
			VAR _sid = [Selected snapshot id]
			RETURN
			    CALCULATE ( MAX ( dim_snapshot[data_date] ), dim_snapshot[snapshot_id] = _sid )
			```
		formatString: dd-mmm-yyyy
		displayFolder: 01 Context
		lineageTag: 5fe95975-e4f5-50a3-b3c1-18bb61513824

	measure 'Previous data date' = ```
			VAR _prev = [Previous snapshot id]
			RETURN
			    CALCULATE (
			        MAX ( dim_snapshot[data_date] ),
			        REMOVEFILTERS ( dim_snapshot ),
			        dim_snapshot[snapshot_id] = _prev
