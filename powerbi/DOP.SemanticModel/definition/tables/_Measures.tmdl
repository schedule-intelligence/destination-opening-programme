		lineageTag: d4729ce7-5f1d-5f71-beaa-0283abaccb3a

	/// Sparkline: the float bridge on page 3 (a waterfall over 'Update axis'[update]), by update
	measure 'Float bridge by update' = ```
			VAR _s = SELECTEDVALUE ( 'Update axis'[snapshot_id] )
			RETURN
			    IF (
			        NOT ISBLANK ( _s ) && _s <= [Selected snapshot id] && NOT ISEMPTY ( fact_snapshot_summary ),
			        CALCULATE ( [Float bridge], REMOVEFILTERS ( dim_snapshot ), dim_snapshot[snapshot_id] = _s )
			    )
			```
		formatString: +0;-0;0
		displayFolder: 15 Sparklines in the tables, and the float bridge
