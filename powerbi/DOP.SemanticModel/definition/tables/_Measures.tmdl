	/// Risk map (page 5): the risks in the cell of the 'Risk grid' row at the selected update, in risk order. An empty cell returns an empty text, not blank, so the matrix keeps all 25 cells
	measure 'Risks in cell' = ```
			VAR _sid = [Selected snapshot id]
			VAR _p = SELECTEDVALUE ( 'Risk grid'[probability] )
			VAR _i = SELECTEDVALUE ( 'Risk grid'[impact] )
			VAR _risks =
			    CALCULATETABLE (
			        VALUES ( fact_risk[risk_id] ),
			        dim_snapshot[snapshot_id] = _sid,
			        fact_risk[probability] = _p,
			        fact_risk[impact] = _i
			    )
			RETURN
			    CONCATENATEX ( _risks, fact_risk[risk_id], ", ", fact_risk[risk_id], ASC ) & ""
			```
		displayFolder: 10 Risks, decisions and recovery
		lineageTag: fe99065e-e880-5750-8fd7-5e9bd99461e6

	/// Risk map (page 5): the cell's band by probability x impact, as the risk rating: high from 15, medium from 8
	measure 'Risk cell colour' = ```
			VAR _score = SELECTEDVALUE ( 'Risk grid'[probability] ) * SELECTEDVALUE ( 'Risk grid'[impact] )
			RETURN
			    SWITCH ( TRUE (), _score >= 15, "#F6D5D1", _score >= 8, "#FBE7C6", "#DDEFE3" )
			```
