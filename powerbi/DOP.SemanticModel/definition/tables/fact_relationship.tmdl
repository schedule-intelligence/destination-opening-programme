	partition fact_relationship-8a7db4c5-1eb8-556c-9165-aca8bea22cac = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(Web.Contents(CsvFolder, [RelativePath = "fact_relationship.csv"]), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Nulls, {
				        {"snapshot_id", Int64.Type},
				        {"pred_id", type text},
				        {"succ_id", type text},
				        {"rel_type", type text},
				        {"lag_d", type number},
				        {"is_driving", type logical},
				        {"slack_d", type number}
				    }, "en-GB"),
				    Label_is_driving = Table.AddColumn(Typed, "is_driving_label", each if [is_driving] = null then null else if [is_driving] then "Yes" else "No", type text)
				in
				    Label_is_driving
				```

	annotation PBI_ResultType = Table
