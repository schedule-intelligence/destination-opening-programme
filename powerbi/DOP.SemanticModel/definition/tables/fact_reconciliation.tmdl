	partition fact_reconciliation-41a260b4-1d16-5a18-b24a-5dc10b6de77f = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "\fact_reconciliation.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Nulls, {
				        {"snapshot_id", Int64.Type},
				        {"control_id", type text},
				        {"control", type text},
				        {"source_value", type text},
				        {"model_value", type text},
				        {"dashboard_value", type text},
				        {"delta", type number},
				        {"passed", type logical}
				    }, "en-GB"),
				    Label_passed = Table.AddColumn(Typed, "passed_label", each if [passed] = null then null else if [passed] then "Pass" else "Fail", type text)
				in
				    Label_passed
				```

	annotation PBI_ResultType = Table
