	partition fact_decision-72d3f576-46fb-5899-9153-5d0ae7462756 = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "\fact_decision.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Nulls, {
				        {"decision_id", type text},
				        {"ask", type text},
				        {"owner", type text},
				        {"raised_data_date", type date},
				        {"needed_by", type date},
				        {"status", type text},
				        {"closed_on", type date},
				        {"linked_activity", type text},
				        {"linked_forecast", type datetime},
				        {"linked_tf_d", type number},
				        {"days_to_need", Int64.Type},
				        {"overdue", type logical},
				        {"outcome", type text}
				    }, "en-GB"),
				    Dates = Table.TransformColumnTypes(Typed, {
				        {"linked_forecast", type date}
				    }),
				    Label_overdue = Table.AddColumn(Dates, "overdue_label", each if [overdue] = null then null else if [overdue] then "Yes" else "No", type text)
				in
				    Label_overdue
				```

	annotation PBI_ResultType = Table
