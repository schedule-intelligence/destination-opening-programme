                "        {\"bl1_start\", type datetime},",
                "        {\"bl1_finish\", type datetime},",
                "        {\"bl_start\", type datetime},",
                "        {\"bl_finish\", type datetime},",
                "        {\"var_finish_bl0_d\", type number},",
                "        {\"var_finish_bl1_d\", type number},",
                "        {\"var_finish_bl_d\", type number},",
                "        {\"prev_finish\", type datetime},",
                "        {\"slip_vs_prev_d\", type number},",
                "        {\"lookback_event\", type text},",
                "        {\"lookback_achieved\", type logical},",
                "        {\"lookahead_start\", type logical},",
                "        {\"lookahead_finish\", type logical},",
                "        {\"lookahead\", type logical},",
                "        {\"planned_pct_bl\", type number},",
                "        {\"constraint_type\", type text},",
                "        {\"constraint_date\", type datetime},",
                "        {\"dq_flags\", type text}",
                "    }, \"en-GB\"),",
                "    Dates = Table.TransformColumnTypes(Typed, {",
                "        {\"actual_start\", type date},",
