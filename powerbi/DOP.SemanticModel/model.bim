        "partitions": [
          {
            "name": "fact_snapshot_summary-5417782b-5cf7-5b0f-ada1-d785fe647c76",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(CsvFolder & \"\\fact_snapshot_summary.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Promoted, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {",
                "        {\"snapshot_id\", Int64.Type},",
                "        {\"label\", type text},",
                "        {\"data_date\", type date},",
                "        {\"baseline\", type text},",
                "        {\"day1_forecast\", type datetime},",
                "        {\"day1_tf_d\", type number},",
                "        {\"day1_var_bl0_d\", type number},",
                "        {\"day1_var_bl1_d\", type number},",
                "        {\"dq_score\", type number},",
                "        {\"dq_rating\", type text},",
                "        {\"cpli\", type number},",
                "        {\"bei\", type number},",
                "        {\"critical_count\", Int64.Type},",
                "        {\"near_critical_count\", Int64.Type},",
                "        {\"longest_path_count\", Int64.Type},",
                "        {\"negative_float_count\", Int64.Type},",
                "        {\"min_float_d\", type number},",
                "        {\"avg_float_d\", type number},",
                "        {\"activities\", Int64.Type},",
                "        {\"complete\", Int64.Type},",
                "        {\"in_progress\", Int64.Type},",
                "        {\"not_started\", Int64.Type},",
                "        {\"float_erosion_d\", type number},",
                "        {\"day1_movement_d\", type number}",
                "    }, \"en-GB\"),",
                "    Dates = Table.TransformColumnTypes(Typed, {",
                "        {\"day1_forecast\", type date}",
                "    })",
                "in",
                "    Dates"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
