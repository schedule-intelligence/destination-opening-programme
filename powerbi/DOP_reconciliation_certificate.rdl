<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
<AutoRefresh>0</AutoRefresh>
<Description>Reconciliation certificate: the forty controls of a data date, source XER against model against dashboard.</Description>
<DataSources><DataSource Name="DOP"><rd:SecurityType>None</rd:SecurityType><ConnectionProperties><DataProvider>PBIDATASET</DataProvider><ConnectString>Data Source=pbiazure://api.powerbi.com/;Identity Provider="https://login.microsoftonline.com/organizations, https://analysis.windows.net/powerbi/api, cecdb5e6-c0f4-4323-9c08-e9b2d442dd15";Initial Catalog=sobe_wowvirtualserver-bfce9993-96be-4e91-9bf8-ea8eb16695cc;Integrated Security=ClaimsToken</ConnectString></ConnectionProperties><rd:DataSourceID>f673e53c-a7fd-5ae1-9097-0a33d0bd48af</rd:DataSourceID><rd:PowerBIWorkspaceName>DOP Schedule Intelligence</rd:PowerBIWorkspaceName><rd:PowerBIDatasetName>DOP</rd:PowerBIDatasetName></DataSource></DataSources>
<DataSets>
<DataSet Name="Updates"><Query><DataSourceName>DOP</DataSourceName><CommandText>EVALUATE
SELECTCOLUMNS (
    dim_snapshot,
    "snapshot_id", dim_snapshot[snapshot_id],
    "label", FORMAT ( dim_snapshot[data_date], "dd-MMM-yyyy" ) &amp; "  (" &amp; dim_snapshot[label] &amp; ")"
)
ORDER BY [snapshot_id] DESC</CommandText></Query><Fields><Field Name="snapshot_id"><DataField>[snapshot_id]</DataField></Field><Field Name="label"><DataField>[label]</DataField></Field></Fields></DataSet>
<DataSet Name="Latest"><Query><DataSourceName>DOP</DataSourceName><CommandText>EVALUATE
ROW ( "snapshot_id", MAXX ( ALL ( dim_snapshot ), dim_snapshot[snapshot_id] ) )</CommandText></Query><Fields><Field Name="snapshot_id"><DataField>[snapshot_id]</DataField></Field></Fields></DataSet>
<DataSet Name="Header"><Query><DataSourceName>DOP</DataSourceName><QueryParameters><QueryParameter Name="Snapshot"><Value>=Parameters!Snapshot.Value</Value></QueryParameter></QueryParameters><CommandText>EVALUATE
CALCULATETABLE (
    ROW (
        "data_date", FORMAT ( [Data date], "dd-MMM-yyyy" ),
        "baseline", [Baseline in force],
        "source_file", [Source file],
        "day1_forecast", FORMAT ( [Day 1 forecast], "dd-MMM-yyyy" ),
        "day1_float", [Day 1 total float],
        "dq_score", [DQ score],
        "controls_passed", [Controls passed],
        "controls_total", [Controls total]
    ),
    dim_snapshot[snapshot_id] = VALUE ( @Snapshot )
)</CommandText></Query><Fields><Field Name="data_date"><DataField>[data_date]</DataField></Field><Field Name="baseline"><DataField>[baseline]</DataField></Field><Field Name="source_file"><DataField>[source_file]</DataField></Field><Field Name="day1_forecast"><DataField>[day1_forecast]</DataField></Field><Field Name="day1_float"><DataField>[day1_float]</DataField></Field><Field Name="dq_score"><DataField>[dq_score]</DataField></Field><Field Name="controls_passed"><DataField>[controls_passed]</DataField></Field><Field Name="controls_total"><DataField>[controls_total]</DataField></Field></Fields></DataSet>
<DataSet Name="Controls"><Query><DataSourceName>DOP</DataSourceName><QueryParameters><QueryParameter Name="Snapshot"><Value>=Parameters!Snapshot.Value</Value></QueryParameter></QueryParameters><CommandText>EVALUATE
SELECTCOLUMNS (
    FILTER ( fact_reconciliation, fact_reconciliation[snapshot_id] = VALUE ( @Snapshot ) ),
    "control_id", fact_reconciliation[control_id],
    "control", fact_reconciliation[control],
    "source_value", fact_reconciliation[source_value],
    "model_value", fact_reconciliation[model_value],
    "dashboard_value", fact_reconciliation[dashboard_value],
    "result", IF ( fact_reconciliation[passed], "Pass", "Fail" )
)
ORDER BY [control_id]</CommandText></Query><Fields><Field Name="control_id"><DataField>[control_id]</DataField></Field><Field Name="control"><DataField>[control]</DataField></Field><Field Name="source_value"><DataField>[source_value]</DataField></Field><Field Name="model_value"><DataField>[model_value]</DataField></Field><Field Name="dashboard_value"><DataField>[dashboard_value]</DataField></Field><Field Name="result"><DataField>[result]</DataField></Field></Fields></DataSet>
</DataSets>
<ReportParameters><ReportParameter Name="Snapshot"><DataType>Integer</DataType><DefaultValue><DataSetReference><DataSetName>Latest</DataSetName><ValueField>snapshot_id</ValueField></DataSetReference></DefaultValue><Prompt>Data date</Prompt><ValidValues><DataSetReference><DataSetName>Updates</DataSetName><ValueField>snapshot_id</ValueField><LabelField>label</LabelField></DataSetReference></ValidValues></ReportParameter></ReportParameters>
<ReportParametersLayout><GridLayoutDefinition><NumberOfColumns>4</NumberOfColumns><NumberOfRows>1</NumberOfRows><CellDefinitions><CellDefinition><ColumnIndex>0</ColumnIndex><RowIndex>0</RowIndex><ParameterName>Snapshot</ParameterName></CellDefinition></CellDefinitions></GridLayoutDefinition></ReportParametersLayout>
<ReportSections><ReportSection><Body><ReportItems><Textbox Name="Eyebrow"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>RECONCILIATION CERTIFICATE</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#2B7A78</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Eyebrow</rd:DefaultName><Top>0cm</Top><Left>0cm</Left><Height>0.5cm</Height><Width>26.7cm</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Statement"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(First(Fields!controls_passed.Value, "Header") = First(Fields!controls_total.Value, "Header"), "Every published number reconciles to the source P6 schedule at " &amp; First(Fields!data_date.Value, "Header") &amp; ".", "The outputs do not reconcile to the source P6 schedule at " &amp; First(Fields!data_date.Value, "Header") &amp; ".")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>14pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#1F3A5F</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Statement</rd:DefaultName><Top>0.5cm</Top><Left>0cm</Left><Height>0.9cm</Height><Width>26.7cm</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Scope"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Dashboard, Power BI report and packs. Source file " &amp; First(Fields!source_file.Value, "Header") &amp; ". Each control compares the value read from the XER export, the value in the star-schema model and the value the dashboard shows; a control passes only when all three agree."</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><Color>#4A5568</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Scope</rd:DefaultName><Top>1.4cm</Top><Left>0cm</Left><Height>0.6cm</Height><Width>26.7cm</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Kpi0Label"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>DATA DATE</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#4A5568</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Kpi0Label</rd:DefaultName><Top>2.3cm</Top><Left>0cm</Left><Height>0.5cm</Height><Width>6.375cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F2F4F7</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>8pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Kpi0Value"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!data_date.Value, "Header")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>15pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#1F3A5F</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Kpi0Value</rd:DefaultName><Top>2.8cm</Top><Left>0cm</Left><Height>0.9cm</Height><Width>6.375cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F2F4F7</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>8pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Kpi0Caption"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Baseline in force " &amp; First(Fields!baseline.Value, "Header")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#4A5568</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Kpi0Caption</rd:DefaultName><Top>3.7cm</Top><Left>0cm</Left><Height>0.55cm</Height><Width>6.375cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F2F4F7</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>8pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Kpi1Label"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>DAY 1 FORECAST</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#4A5568</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Kpi1Label</rd:DefaultName><Top>2.3cm</Top><Left>6.775cm</Left><Height>0.5cm</Height><Width>6.375cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F2F4F7</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>8pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Kpi1Value"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!day1_forecast.Value, "Header")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>15pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#1F3A5F</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Kpi1Value</rd:DefaultName><Top>2.8cm</Top><Left>6.775cm</Left><Height>0.9cm</Height><Width>6.375cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F2F4F7</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>8pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Kpi1Caption"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Total float " &amp; Format(First(Fields!day1_float.Value, "Header"), "+0;-0;0") &amp; " working days"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#4A5568</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Kpi1Caption</rd:DefaultName><Top>3.7cm</Top><Left>6.775cm</Left><Height>0.55cm</Height><Width>6.375cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F2F4F7</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>8pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Kpi2Label"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>SCHEDULE QUALITY</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#4A5568</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Kpi2Label</rd:DefaultName><Top>2.3cm</Top><Left>13.55cm</Left><Height>0.5cm</Height><Width>6.375cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F2F4F7</BackgroundColor><VerticalAlign>Middle</VerticalAlign