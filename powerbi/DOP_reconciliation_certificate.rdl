uns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Kpi3Label</rd:DefaultName><Top>2.3cm</Top><Left>20.325cm</Left><Height>0.5cm</Height><Width>6.375cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F2F4F7</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>8pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Kpi3Value"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!controls_passed.Value, "Header") &amp; " of " &amp; First(Fields!controls_total.Value, "Header")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>15pt</FontSize><FontWeight>SemiBold</FontWeight><Color>=IIF(First(Fields!controls_passed.Value, "Header") = First(Fields!controls_total.Value, "Header"), "#1A6E3C", "#A93226")</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Kpi3Value</rd:DefaultName><Top>2.8cm</Top><Left>20.325cm</Left><Height>0.9cm</Height><Width>6.375cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F2F4F7</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>8pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Kpi3Caption"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(First(Fields!controls_passed.Value, "Header") = First(Fields!controls_total.Value, "Header"), "Reconciled: publication allowed", "Not reconciled: publication blocked")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#4A5568</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Kpi3Caption</rd:DefaultName><Top>3.7cm</Top><Left>20.325cm</Left><Height>0.55cm</Height><Width>6.375cm</Width><Style><Border><Style>None</Style></Border><BackgroundColor>#F2F4F7</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>8pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Tablix Name="ControlsTable"><TablixBody><TablixColumns><TablixColumn><Width>3.4cm</Width></TablixColumn><TablixColumn><Width>6.8cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>1.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.65cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="h_control_id"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>ID</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>h_control_id</rd:DefaultName><Style><Border><Style>None</Style></Border><BackgroundColor>#1F3A5F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_control"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Control</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>h_control</rd:DefaultName><Style><Border><Style>None</Style></Border><BackgroundColor>#1F3A5F</BackgroundColor><VerticalAlign>Middle</VerticalAlig